# Replace domain, certificate paths and static root before deployment.
server {
    listen 443 ssl;
    server_name admin.example.com;
    ssl_certificate /etc/ssl/admin/fullchain.pem;
    ssl_certificate_key /etc/ssl/admin/privkey.pem;
    root /var/www/havefun-admin;
    index index.html;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    add_header X-Frame-Options DENY always;
    location /api/admin/v1/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 60s;
    }
    location / { try_files $uri $uri/ /index.html; }
}
server {
    listen 80;
    server_name admin.example.com;
    return 301 https://$host$request_uri;
}
